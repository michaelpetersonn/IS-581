{
  "name": "c3nsor-policy-proxy",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test worker.test.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs --env production",
    "deploy:staging": "node scripts/deploy.mjs --env staging",
    "health": "node ../scripts/monitor.mjs --proxy-only",
    "health:staging": "node ../scripts/monitor.mjs --proxy-only --proxy-url https://c3nsor-policy-proxy-staging.petersonmichaelc.workers.dev"
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
