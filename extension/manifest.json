{
  "manifest_version": 3,
  "name": "c3nsor",
  "version": "0.1.0",
  "description": "Find a site’s privacy policy and show five key data practices in clear English — with citations and action links. Analysis runs locally with rules, not AI.",
  "action": {
    "default_title": "c3nsor — privacy checkpoint",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": []
}
