{
  "name": "c3nsor",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm@sha256:0d29e5fdc64f8397cd502223e0c4679f1e60877ca0fd2db4f2e2e0028e4271af",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.21.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm ci && npm --prefix proxy ci",
  "forwardPorts": [8765, 8787],
  "portsAttributes": {
    "8765": { "label": "Website preview" },
    "8787": { "label": "Wrangler dev (proxy)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  }
}
